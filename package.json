{
  "name": "dashboard-kominfo-ppu",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard Terpadu Pemkab Penajam Paser Utara (BKPSDM & Diskominfo PPU)",
  "workspaces": [
    "server",
    "UI"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,UI\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "npm --prefix server run dev",
    "dev:ui": "npm --prefix UI run dev",
    "start": "concurrently -n \"SERVER,UI\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:ui\"",
    "build": "npm --prefix UI run build",
    "install:all": "npm install --no-workspaces && npm --prefix server install && npm --prefix UI install",
    "seed": "node server/scripts/seed-kominfo.js",
    "inspect:db": "node server/scripts/inspect-db.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
